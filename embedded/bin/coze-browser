#!/bin/sh
set -eu
coze_browser_app="${COZE_BROWSER_APP:-}"
coze_browser_bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -z "$coze_browser_app" ] && [ -x "$coze_browser_bin_dir/../../../../Contents/MacOS/CozeAccountBrowser" ]; then
  coze_browser_app=$(CDPATH= cd -- "$coze_browser_bin_dir/../../../.." && pwd)
fi
if [ -z "$coze_browser_app" ]; then
  for directory in "$HOME/Applications" /Applications; do
    for name in '智进化 AI 工作台.app' '扣子账号浏览器.app'; do
      candidate="$directory/$name"
      if [ -x "$candidate/Contents/MacOS/CozeAccountBrowser" ]; then
        coze_browser_app="$candidate"
        break 2
      fi
    done
  done
fi
if [ -z "$coze_browser_app" ] || [ ! -x "$coze_browser_app/Contents/MacOS/CozeAccountBrowser" ]; then
  echo '智进化 AI 工作台尚未安装。' >&2
  exit 1
fi
exec env ELECTRON_RUN_AS_NODE=1 COZE_BROWSER_APP="$coze_browser_app" "$coze_browser_app/Contents/MacOS/CozeAccountBrowser" "$coze_browser_app/Contents/Resources/app/src/cli.cjs" "$@"
